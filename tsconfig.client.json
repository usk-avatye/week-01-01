{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "public/assets",
    "lib": ["ES2022", "DOM"],
    "types": []
  },
  "include": ["src/client/**/*.ts", "src/contracts/**/*.ts"]
}
